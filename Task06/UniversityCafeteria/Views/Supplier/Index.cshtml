@model IEnumerable<Supplier>
@{ ViewData["Title"] = "Suppliers"; }
<h1>Suppliers</h1>
<p>@Html.ActionLink("Add supplier", "Create", null, new { @class = "button" })</p>
@if (!Model.Any())
{
    <p>No suppliers yet. Add one to get started.</p>
}
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Name)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Phone)</th>
                <th scope="col">@Html.DisplayNameFor(model => model.Email)</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@{
    ViewData["Title"] = "Home";
    string universityName = "Orange University";
    string managerName = "Ahmad Ali";
    int totalProducts = 5;
}

<h1>Welcome to @universityName</h1>
<p>Manager: @managerName</p>
<p>Total products: @totalProducts</p>

<ul>
    <li><a asp-controller="Cafeteria" asp-action="Index">Home</a></li>
    <li><a asp-controller="Cafeteria" asp-action="Products">Products</a></li>
    <li><a asp-controller="Cafeteria" asp-action="Suppliers">Suppliers</a></li>
    <li><a asp-controller="Cafeteria" asp-action="SupplyStatus">Supply Status</a></li>
</ul>

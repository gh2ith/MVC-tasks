


@{
    ViewData["Title"] = "Supply Status";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Cafeteria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
    <main class="container py-4">
        <h1 class="display-4">Supply Status</h1>

        @{
            var supplyStatus = new[]
            {
                new { Product = "item1", Supplier = "supplier1", Quantity = 10, Status = "In Stock" },
                new { Product = "item2", Supplier = "supplier2", Quantity = 5, Status = "Low Stock" },
                new { Product = "item3", Supplier = "supplier3", Quantity = 1, Status = "Out of Stock" },
                new { Product = "item4", Supplier = "supplier4", Quantity = 110, Status = "Out of Stock" }
            };
        }

        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Supplier</th>
                    <th>Quantity</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in supplyStatus)
        {
                <tr>
                    <td>@item.Product</td>
                    <td>@item.Supplier</td>
                    <td>@item.Quantity</td>
                    <td>
                        @if (item.Status == "In Stock")
                        {
                            <span class="badge bg-success">@item.Status</span>
                        }
                        else if (item.Status == "Low Stock")
                        {
                            <span class="badge bg-warning">@item.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@item.Status</span>
                        }
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </main>
</body>
</html>

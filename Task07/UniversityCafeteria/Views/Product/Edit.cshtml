@model Product

<h1>Edit Product</h1>

<form method="post" action="@Url.Action("Edit", "Product")">
    @Html.ValidationSummary()
    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Name</label>
    <input type="text" name="Name" value="@Model.Name" />
    <br />

    <label>Description</label>
    <input type="text" name="Description" value="@Model.Description" />
    <br />

    <label>Price</label>
    <input type="text" name="Price" value="@Model.Price" />
    <br />

    <label>Quantity</label>
    <input type="text" name="Quantity" value="@Model.Quantity" />
    <br />

    <label>Category</label>
    @Html.DropDownListFor(x => x.CategoryId, (SelectList)ViewBag.Categories)
    <br />

    <label>Supplier</label>
    @Html.DropDownListFor(x => x.SupplierId, (SelectList)ViewBag.Suppliers)
    <br />

    <button type="submit">Save</button>
</form>

<a href="@Url.Action("Index", "Product")">Back</a>

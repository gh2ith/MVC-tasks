@model Order

<h1>Edit Order</h1>

<form method="post" action="@Url.Action("Edit", "Order")">
    @Html.ValidationSummary()
    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Customer Name</label>
    <input type="text" name="CustomerName" value="@Model.CustomerName" />
    <br />

    <label>Order Date</label>
    <input type="datetime-local" name="OrderDate" value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")" />
    <br />

    <label>Total Price</label>
    <input type="text" name="TotalPrice" value="@Model.TotalPrice" />
    <br />

    <label>Status</label>
    <input type="text" name="Status" value="@Model.Status" />
    <br />

    <label>Employee</label>
    @Html.DropDownListFor(x => x.EmployeeId, (SelectList)ViewBag.Employees)
    <br />

    <button type="submit">Save</button>
</form>

<a href="@Url.Action("Index", "Order")">Back</a>

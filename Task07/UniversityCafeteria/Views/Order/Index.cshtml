@model IEnumerable<Order>

<h1>Orders</h1>

<a href="@Url.Action("Create", "Order")">Add New</a>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Customer Name</th>
            <th>Order Date</th>
            <th>Total Price</th>
            <th>Status</th>
            <th>Employee</th>
            <th>Edit</th>
            <th>Details</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.CustomerName</td>
                <td>@item.OrderDate</td>
                <td>@item.TotalPrice</td>
                <td>@item.Status</td>
                <td>@(item.Employee?.FullName)</td>
                <td>
                    <a href="@Url.Action("Edit", "Order", new { id = item.Id })">Edit</a>
                </td>
                <td>
                    <a href="@Url.Action("Details", "Order", new { id = item.Id })">Details</a>
                </td>
                <td>
                    <form method="post" action="@Url.Action("Delete", "Order")">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

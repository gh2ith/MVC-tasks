@model List<mvctask04.Models.SupplyRequest>

<h2>My Supply Requests</h2>

<table class="table">

    <thead>
        <tr>
            <th>Request ID</th>
            <th>Number of Products</th>
            <th>Subtotal</th>
            <th>Preparation Fee</th>
            <th>Discount</th>
            <th>Final Total</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var request in Model)
        {
            <tr>
                <td>@request.RequestId</td>

                <td>@request.NumberOfProducts</td>

                <td>@request.Subtotal JD</td>

                <td>@request.PreparationFee JD</td>

                <td>@request.Discount JD</td>

                <td>@request.FinalTotal JD</td>

                <td>@request.Status</td>
            </tr>
        }

    </tbody>

</table>
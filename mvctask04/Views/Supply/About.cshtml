@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5 text-center">
    <h1 class="display-5 fw-bold text-primary mb-4">About Us</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success fs-5 shadow-sm d-inline-block px-4 py-3 mb-3">
            @TempData["Message"]
        </div>
        <br />
    }

    @if (TempData["QuantityMessage"] != null)
    {
        <div class="alert alert-info fs-5 shadow-sm d-inline-block px-4 py-3 border border-info">
            <strong>@TempData["QuantityMessage"]</strong>
        </div>
        <br />
    }

    @if (TempData["Message"] == null && TempData["QuantityMessage"] == null)
    {
        <p class="fs-5 text-muted">Use this application to view cafeteria products, check suppliers, and submit supply requests.</p>
    }
</div>
<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">@ViewBag.Title</h1>
        <p class="lead text-muted">
            Total Suppliers: <span class="badge bg-success rounded-pill px-3 py-2">@ViewBag.SuppliersCount</span>
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <ul class="list-group shadow-sm">
                @foreach (var supplier in ViewBag.SuppliersList)
                {
                    <li class="list-group-item py-3 fs-5 text-center bg-light border-light mb-2 rounded text-dark fw-medium">
                        @supplier
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Cafeteria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Cafeteria" asp-action="Index">
                    University Cafeteria
                </a>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SupplyRequest" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SupplyRequest" asp-action="Review">Review</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SupplyRequest" asp-action="MyRequests">My Requests</a>
                    </li>

                    <li class="nav-item">
                        <a href="@Url.Action("About", "SupplyRequest")">
                            About
                        </a>
                    </li>

         
                </ul>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top text-muted text-center py-3">
        &copy; 2026 - University Cafeteria Supply Management System
    </footer>
    @RenderSection("Scripts", required: false).
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | University Cafeteria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UniversityCafeteria.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-light mb-4" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Cafeteria" asp-action="Index">University Cafeteria</a>
                <ul class="navbar-nav flex-row flex-wrap gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-dark p-3" asp-controller="Cafeteria" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark p-3" asp-controller="Cafeteria" asp-action="Products">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark p-3" asp-controller="Cafeteria" asp-action="Suppliers">Suppliers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark p-3" asp-controller="Cafeteria" asp-action="SupplyStatus">Supply status</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer text-muted">
        <div class="container">
            &copy; 2026 University Cafeteria
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
